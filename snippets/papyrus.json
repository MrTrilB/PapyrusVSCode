{
  "ScriptName": {
    "scope": "papyrus",
    "prefix": "scriptname",
    "body": [
      "ScriptName ${1:MyScript} extends ${2:Quest}",
      ""
    ],
    "description": "Declare script name and base type"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "Import ${1:SomeLibrary}"
    ],
    "description": "Import another script"
  },
  "Property": {
    "prefix": "prop",
    "body": [
      "${1:Type} Property ${2:MyProp} Auto"
    ],
    "description": "Auto property"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "Function ${1:MyFunction}(${2:params})",
      "    ${3:// code}",
      "EndFunction"
    ],
    "description": "Function block"
  },
  "Event": {
    "prefix": "event",
    "body": [
      "Event ${1:OnInit}(${2:params})",
      "    ${3:// code}",
      "EndEvent"
    ],
    "description": "Event block"
  },
  "If": {
    "prefix": "if",
    "body": [
      "If ${1:condition}",
      "    ${2:// code}",
      "EndIf"
    ],
    "description": "If block"
  },
  "IfElse": {
    "prefix": "ifel",
    "body": [
      "If ${1:condition}",
      "    ${2:// code}",
      "Else",
      "    ${3:// else}",
      "EndIf"
    ],
    "description": "If/Else block"
  },
  "ElseIf": {
    "prefix": "elseif",
    "body": [
      "ElseIf ${1:condition}"
    ],
    "description": "ElseIf line"
  },
  "While": {
    "prefix": "while",
    "body": [
      "While ${1:condition}",
      "    ${2:// code}",
      "EndWhile"
    ],
    "description": "While loop"
  }
}
