{
  "name": "papyrus-tools",
  "displayName": "Papyrus Tools",
  "description": "Papyrus scripting support: syntax highlighting, snippets, completions, and hovers.",
  "version": "0.1.9",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrTrilB/PapyrusVSCode.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "sideEffects": false,
  "activationEvents": [
    "onCommand:papyrus.compileFile",
    "onCommand:papyrus.switchGame",
    "onCommand:papyrus.configureCompilers",
    "onCommand:papyrus.configureScriptFolders",
    "onCommand:papyrus.rebuildIndex",
    "onCommand:papyrus.addScriptFolder",
    "onCommand:papyrus.autoDetectGamePaths",
    "onCommand:papyrus.scanScriptsForDiagnostics",
    "onCommand:papyrus.openCurrentGameSettings",
    "onCommand:papyrus.exportCurrentProfile",
    "onCommand:papyrus.importProfile",
    "onCommand:papyrus.createDefaultProfiles",
    "onCommand:papyrus.openWorkspaceSettingsJson"
  ],
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "aliases": [
          "Papyrus",
          "papyrus"
        ],
        "extensions": [
          ".psc",
          ".pex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "papyrus",
        "scopeName": "source.papyrus",
        "path": "./syntaxes/papyrus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "papyrus",
        "path": "./snippets/papyrus.json"
      }
    ],
    "commands": [
      {
        "command": "papyrus.compileFile",
        "title": "Papyrus: Compile Current File"
      },
      {
        "command": "papyrus.switchGame",
        "title": "Papyrus: Switch Game Profile"
      },
      {
        "command": "papyrus.configureCompilers",
        "title": "Papyrus: Configure Compiler Paths"
      },
      {
        "command": "papyrus.configureScriptFolders",
        "title": "Papyrus: Configure Script Folders"
      },
      {
        "command": "papyrus.rebuildIndex",
        "title": "Papyrus: Rebuild Script Index"
      },
      {
        "command": "papyrus.addScriptFolder",
        "title": "Papyrus: Add Script Folder"
      },
      {
        "command": "papyrus.autoDetectGamePaths",
        "title": "Papyrus: Auto-Detect Game Paths"
      },
      {
        "command": "papyrus.scanScriptsForDiagnostics",
        "title": "Papyrus: Scan Scripts for Diagnostics"
      },
      {
        "command": "papyrus.openCurrentGameSettings",
        "title": "Papyrus: Open Current Game Settings"
      },
      {
        "command": "papyrus.openWorkspaceSettingsJson",
        "title": "Papyrus: Open Workspace Settings (JSON)"
      },
      {
        "command": "papyrus.exportCurrentProfile",
        "title": "Papyrus: Export Current Game Profile"
      },
      {
        "command": "papyrus.importProfile",
        "title": "Papyrus: Import Game Profile"
      },
      {
        "command": "papyrus.createDefaultProfiles",
        "title": "Papyrus: Create Default Game Profiles"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .psc",
          "command": "papyrus.compileFile",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "papyrus.compileFile",
          "when": "true"
        },
        {
          "command": "papyrus.switchGame",
          "when": "true"
        },
        {
          "command": "papyrus.autoDetectGamePaths",
          "when": "true"
        },
        {
          "command": "papyrus.scanScriptsForDiagnostics",
          "when": "true"
        },
        {
          "command": "papyrus.openCurrentGameSettings",
          "when": "true"
        },
        {
          "command": "papyrus.openWorkspaceSettingsJson",
          "when": "true"
        },
        {
          "command": "papyrus.exportCurrentProfile",
          "when": "true"
        },
        {
          "command": "papyrus.importProfile",
          "when": "true"
        },
        {
          "command": "papyrus.createDefaultProfiles",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Papyrus Tools",
      "properties": {
        "papyrus.game": {
          "type": "string",
          "enum": ["Skyrim", "SkyrimSE", "SkyrimAE", "Fallout4", "Fallout76", "Starfield"],
          "default": "Skyrim",
          "description": "Active game profile to use for Papyrus features and compiler settings.",
          "markdownDescription": "Active game profile to use for Papyrus features and compiler settings. Selecting a game automatically applies default script paths and compiler locations for that title.",
          "order": 0
        },
        "papyrus.skyrim": {
          "type": "object",
          "description": "Convenience defaults for Skyrim, SkyrimSE, and SkyrimAE.",
          "markdownDescription": "Convenience defaults for **Skyrim**-family games. These values are pre-populated when you select a Skyrim profile.",
          "default": {},
          "order": 10,
          "properties": {
            "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Skyrim scripts folders (typically Data/\\Scripts/Source)." },
            "compiler": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "default": "", "description": "Path to PapyrusCompiler.exe for Skyrim." },
                "args": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional compiler args for Skyrim." },
                "cwd": { "type": "string", "default": "", "description": "Working directory to run the Skyrim compiler (optional)." }
              }
            }
          }
        },
        "papyrus.fallout4": {
          "type": "object",
          "description": "Convenience defaults for Fallout 4.",
          "markdownDescription": "Convenience defaults for **Fallout 4**. Values are pre-populated when you switch to the Fallout 4 profile.",
          "default": {},
          "order": 11,
          "properties": {
            "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Fallout 4 scripts folders (typically Data/\\Scripts/Source)." },
            "compiler": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "default": "", "description": "Path to PapyrusCompiler.exe for Fallout 4." },
                "args": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional compiler args for Fallout 4." },
                "cwd": { "type": "string", "default": "", "description": "Working directory to run the Fallout 4 compiler (optional)." }
              }
            }
          }
        },
        "papyrus.starfield": {
          "type": "object",
          "description": "Convenience defaults for Starfield.",
          "markdownDescription": "Convenience defaults for **Starfield**. Values are pre-populated when you switch to the Starfield profile.",
          "default": {},
          "order": 12,
          "properties": {
            "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Starfield scripts folders (typically Data/\\Scripts/Source)." },
            "compiler": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "default": "", "description": "Path to PapyrusCompiler.exe for Starfield." },
                "args": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional compiler args for Starfield." },
                "cwd": { "type": "string", "default": "", "description": "Working directory to run the Starfield compiler (optional)." }
              }
            }
          }
        },
        "papyrus.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Full path to the Papyrus compiler executable (e.g. PapyrusCompiler.exe).",
          "order": 20
        },
        "papyrus.compiler.args": {
          "type": "array",
          "default": [],
          "description": "Additional arguments to pass to the Papyrus compiler.",
          "order": 21
        },
        "papyrus.compiler.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory to run the compiler in (optional).",
          "order": 22
        },
        "papyrus.compiler.includeFlag": {
          "type": "string",
          "default": "-i",
          "description": "Compiler include flag used to pass script include paths (e.g. -i).",
          "order": 23
        },
        "papyrus.compiler.pathSeparator": {
          "type": "string",
          "default": ";",
          "description": "Path list separator when passing multiple include paths (default ';').",
          "order": 24
        },
        "papyrus.games": {
          "type": "object",
          "description": "Per-game compiler settings. Keys: skyrim, skyrimse, skyrimae, fallout4, fallout76, starfield.",
          "markdownDescription": "Advanced: raw per-game profile data backing the convenience categories. You usually do not need to edit this manually.",
          "default": {},
          "order": 80,
          "properties": {
            "skyrim": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            },
            "skyrimse": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            },
            "skyrimae": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            },
            "fallout4": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            },
            "fallout76": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            },
            "starfield": {
              "type": "object",
              "properties": {
                "scriptPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
                "compiler": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "default": "" },
                    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
                    "cwd": { "type": "string", "default": "" }
                  }
                }
              }
            }
          }
        },
        "papyrus.autoDetect": {
          "type": "object",
          "description": "Auto-detection settings for game paths.",
          "default": {},
          "order": 90,
          "properties": {
            "useLibraryFoldersVdf": {
              "type": "boolean",
              "default": true,
              "description": "Parse Steam libraryfolders.vdf to discover additional library locations."
            },
            "additionalBasePaths": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Additional base library paths. You can provide either the library root, 'steamapps', or 'steamapps/common'."
            },
            "includeBothScriptPaths": {
              "type": "boolean",
              "default": false,
              "description": "When true, include both Data\\Scripts\\Source and Data\\Scripts if both exist. Otherwise prefer Source only."
            },
            "enableSkyrim": { "type": "boolean", "default": true, "description": "Enable auto-detect for Skyrim." },
            "enableSkyrimSE": { "type": "boolean", "default": true, "description": "Enable auto-detect for Skyrim Special Edition." },
            "enableSkyrimAE": { "type": "boolean", "default": true, "description": "Enable auto-detect for Skyrim Anniversary Edition (shares SE path)." },
            "enableFallout4": { "type": "boolean", "default": true, "description": "Enable auto-detect for Fallout 4." },
            "enableFallout76": { "type": "boolean", "default": true, "description": "Enable auto-detect for Fallout 76." },
            "enableStarfield": { "type": "boolean", "default": true, "description": "Enable auto-detect for Starfield." }
            }
          }
        }
      }
    },
  "scripts": {
    "vscode:prepublish": "npm run webpack-prod",
    "compile": "npm run webpack-dev",
    "watch": "webpack --watch --mode development",
    "webpack-dev": "webpack --mode development",
    "webpack-prod": "webpack --mode production",
    "package": "vsce package",
    "lint": "echo 'No linter configured'",
    "test-compile": "tsc -p ./tsconfig.test.json",
    "test": "npm run webpack-dev && npm run test-compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.0.0",
    "@vscode/test-electron": "^2.4.1",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "glob": "^8.1.0",
    "mocha": "^10.7.3",
    "source-map-loader": "^5.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "typescript": "^5.6.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
